{
  "name": "workflow-telemetry-action",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action that collects CPU, memory, disk, network, step, and process telemetry from workflow jobs, shows it in the job summary, and can send it to PostHog",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,mjs}\"",
    "format-check": "prettier --check \"**/*.{ts,mjs}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "package:main": "ncc build --source-map src/main.ts --out dist/main",
    "package:post": "ncc build --source-map src/post.ts --out dist/post",
    "package:collect": "ncc build --source-map src/collect.ts --out collect/dist",
    "package:sampler": "cp src/sampler.sh dist/sampler.sh",
    "package": "npm run package:main && npm run package:post && npm run package:collect && npm run package:sampler",
    "all": "npm run format-check && npm run lint && npm run build && npm test && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPlaygrounds/GitHub-Action-Telemetry.git"
  },
  "keywords": [
    "monitoring",
    "observability",
    "telemetry",
    "github",
    "actions",
    "workflow",
    "ci-cd",
    "posthog"
  ],
  "author": "Serkan Özal <serkan@thundra.io>",
  "contributors": [
    "0xPlaygrounds"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/openapi-types": "^29.0.1",
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
